# Copy this file to .env and fill in your values

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Google Sheet ID (can also enter in the UI)
GOOGLE_SHEET_ID=

# Flask secret key for session management (change to a random string)
FLASK_SECRET_KEY=change-me-to-a-random-secret-string

# OAuth callback URL (local default)
# For cloud deploy set this to your public domain callback,
# e.g. https://your-app.onrender.com/auth/callback
REDIRECT_URI=http://localhost:5000/auth/callback

# Optional override paths for OAuth files
# GOOGLE_OAUTH_CREDENTIALS_PATH=credentials.json
# TOKEN_PATH=token.json
